{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyDiary",
  "version": "0.1.0",
  "identifier": "com.mydiary.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MyDiary",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "llm": {
      "llmconfig": {
        "name": "Qwen3-0.6B-Instruct",
        "tokenizer_file": "./models/Qwen3-0.6B-Instruct/tokenizer.json",
        "tokenizer_config_file": "./models/Qwen3-0.6B-Instruct/tokenizer_config.json",
        "model_config_file": "./models/Qwen3-0.6B-Instruct/config.json",
        "model_index_file": "./models/Qwen3-0.6B-Instruct/model.safetensors.index.json",
        "model_dir": "./models/Qwen3-0.6B-Instruct/"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
