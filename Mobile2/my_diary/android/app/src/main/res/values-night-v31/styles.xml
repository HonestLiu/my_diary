<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 深色启动屏：windowBackground 改纯黑避免与图标叠加，
     iconBackgroundColor 保留品牌蓝圆，让 240dp 圆形与图标无缝衔接。 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#AED2EB</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_image</item>
    </style>
</resources>
