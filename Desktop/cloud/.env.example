# ---- Service ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:1420,http://localhost:5173

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg://mydiary:mydiary@localhost:5432/mydiary

# ---- Auth ----
# Generate a strong secret, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
SYNC_TOKEN_TTL_DAYS=365

# ---- Object storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO / Aliyun OSS) ----
# The cloud mints presigned URLs against THIS bucket. Bodies never touch the cloud.
S3_BUCKET=mydiary
S3_REGION=us-east-1
# Leave S3_ENDPOINT empty for AWS S3. For MinIO/R2/OSS set the endpoint host.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true for MinIO / Aliyun OSS path-style; false for AWS / R2 virtual-hosted.
S3_PATH_STYLE=false
S3_PRESIGN_TTL_SECONDS=900
